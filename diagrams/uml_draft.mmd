classDiagram
    direction LR

    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +remove_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +str name
        +str species
        +int age
        +list tasks
        +add_task(task)
        +remove_task(task)
        +get_tasks()
    }

    class Task {
        +str description
        +str time
        +date due_date
        +int duration
        +str priority
        +str frequency
        +bool completed
        +mark_complete()
        +next_occurrence()
    }

    class Scheduler {
        +Owner owner
        +get_schedule()
        +sort_by_time()
        +filter_tasks()
        +detect_conflicts()
        +mark_task_complete()
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : contains
    Scheduler --> Owner : retrieves tasks